diff --git a/node_modules/scratch-paint/src/reducers/selection-mode.js b/src/reducers/selection-mode.js
new file mode 100644
index 000000000..c2d28b337
--- /dev/null
+++ b/src/reducers/selection-mode.js
@@ -0,0 +1,42 @@
+const CHANGE_VECTOR_LASSO_ENABLED = 'scratch-paint/selection-mode/CHANGE_VECTOR_LASSO_ENABLED';
+const CHANGE_BITMAP_LASSO_ENABLED = 'scratch-paint/selection-mode/CHANGE_BITMAP_LASSO_ENABLED';
+
+const initialState = {
+    bitmapLassoEnabled: false,
+    vectorLassoEnabled: false
+};
+
+const reducer = (state, action) => {
+    if (typeof state === 'undefined') state = initialState;
+    switch (action.type) {
+    case CHANGE_VECTOR_LASSO_ENABLED:
+        return {
+            ...state,
+            vectorLassoEnabled: Boolean(action.enabled)
+        };
+    case CHANGE_BITMAP_LASSO_ENABLED:
+        return {
+            ...state,
+            bitmapLassoEnabled: Boolean(action.enabled)
+        };
+    default:
+        return state;
+    }
+};
+
+const changeVectorLassoEnabled = enabled => ({
+    type: CHANGE_VECTOR_LASSO_ENABLED,
+    enabled
+});
+
+const changeBitmapLassoEnabled = enabled => ({
+    type: CHANGE_BITMAP_LASSO_ENABLED,
+    enabled
+});
+
+export {
+    reducer as default,
+    initialState,
+    changeVectorLassoEnabled,
+    changeBitmapLassoEnabled
+};
